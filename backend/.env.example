# ==============================================================================
# FocusForge Backend Environment Configuration
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Port number for the HTTP server (default: 5001 for local/docker, 10000 for Render)
PORT=5001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Secret key used for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a cryptographically strong 64-character secret
JWT_SECRET=focusforge_super_secure_jwt_secret_key_change_in_production_2026

# Token expiration duration (e.g., '1h', '24h', '7d', '30d')
JWT_EXPIRES_IN=7d

# SQLite database file path (relative to backend root or absolute)
DB_PATH=./data/focusforge.db

# Allowed CORS origins (e.g. '*' for all, or 'http://localhost:3000,http://localhost:8081')
CORS_ORIGIN=*
